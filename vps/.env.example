# Your server domain (must point to this VPS via DNS A record)
DOMAIN=evo.yourdomain.com

# Evolution API key — generate a strong random string
# openssl rand -hex 32
EVOLUTION_API_KEY=change_me_strong_random_key

# PostgreSQL password — generate a strong random string
POSTGRES_PASSWORD=change_me_postgres_password

# Redis password — generate a strong random string
REDIS_PASSWORD=change_me_redis_password

# Supabase Edge Function webhook URL
# From: supabase functions deploy  (then copy the evolution-webhook URL)
WEBHOOK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/evolution-webhook
